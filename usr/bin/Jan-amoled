#!/bin/bash
# Jan AMOLED launcher: re-applies the pure-black patch if the binary was
# replaced (e.g. by an update) and we can write to it, then starts Jan.
# --no-prompt preserves the existing AMOLED/noCSD choice so GUI launches
# never block on the terminal menu.
PATCH=/usr/lib/jan-amoled/jan-amoled-patch.py
if [ -w /usr/bin/Jan ] && [ -f "$PATCH" ]; then
  python3 "$PATCH" --no-prompt /usr/bin/Jan >/dev/null 2>&1
fi
